# BeAstar.io - Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your values
# 
# NEVER commit your actual .env file to version control!
# Add .env to your .gitignore

# ==========================================================================
# APPLICATION
# ==========================================================================

# Base URL for the application (used in QR codes, webhooks, etc.)
APP_BASE_URL=https://api.beastar.io

# ==========================================================================
# SUPABASE / DATABASE
# ==========================================================================

# Supabase URL (from your Supabase project settings)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (from your Supabase project settings)
SUPABASE_KEY=your-supabase-service-role-key

# Storage bucket name for generated videos
SUPABASE_STORAGE_BUCKET=generations

# ==========================================================================
# AI VIDEO GENERATION PROVIDERS
# ==========================================================================

# Runway ML API Key (primary provider)
# Get from: https://runwayml.com/
RUNWAY_API_KEY=your-runway-api-key

# Kling AI API Key (fallback provider)
# Get from: https://kling.ai/
KLING_API_KEY=your-kling-api-key

# Kling API Base URL (optional, if using custom endpoint)
KLING_API_BASE=https://api.kling.ai/v1

# ==========================================================================
# FACE VERIFICATION & CONTENT MODERATION
# ==========================================================================

# AWS Region for Rekognition
AWS_REGION=us-east-1

# AWS Access Key ID (for Rekognition face verification)
AWS_ACCESS_KEY_ID=your-aws-access-key

# AWS Secret Access Key (for Rekognition face verification)
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Hive AI API Key (fallback moderation provider)
# Get from: https://hive.ai/
HIVE_API_KEY=your-hive-api-key

# Hive API Base URL (optional)
HIVE_API_BASE=https://api.hive.ai

# ==========================================================================
# REDIS (for Celery background jobs)
# ==========================================================================

# Redis URL for Celery broker and result backend
REDIS_URL=redis://localhost:6379/0

# Redis password (optional, if your Redis requires authentication)
REDIS_PASSWORD=

# ==========================================================================
# PAYMENTS - STRIPE
# ==========================================================================

# Stripe Secret Key (for creating subscriptions)
STRIPE_SECRET_KEY=your-stripe-secret-key

# Stripe Webhook Secret (for verifying webhook signatures)
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ==========================================================================
# PAYMENTS - PAYMONGO / GCASH
# ==========================================================================

# PayMongo Secret Key (for GCash payments)
PAYMONGO_SECRET_KEY=your-paymongo-secret-key

# PayMongo Webhook Secret (for verifying webhook signatures)
PAYMONGO_WEBHOOK_SECRET=your-paymongo-webhook-secret

# PayMongo API Base URL (optional)
PAYMONGO_API_BASE=https://api.paymongo.com/v1

# ==========================================================================
# LOGGING
# ==========================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==========================================================================
# DEVELOPMENT / TESTING
# ==========================================================================

# Set to true to use real backend (Supabase) instead of in-memory dicts
USE_REAL_BACKEND=true

# Set to true to enable debug mode
DEBUG=false

# ==========================================================================
# CELERY CONFIGURATION
# ==========================================================================

# Celery broker URL (same as REDIS_URL by default)
CELERY_BROKER_URL=${REDIS_URL}

# Celery result backend URL
CELERY_RESULT_BACKEND=${REDIS_URL}

# Celery concurrency (number of worker processes)
CELERY_CONCURRENCY=4

# ==========================================================================
# DOCKER COMPOSE OVERRIDES
# ==========================================================================

# Run database migrations on startup
RUN_MIGRATIONS=false

# Setup RPC functions on startup
SETUP_RPC=true

# ==========================================================================
# RATE LIMITING
# ==========================================================================

# Rate limit for API endpoints (requests per minute)
API_RATE_LIMIT=100

# Rate limit for auth endpoints
AUTH_RATE_LIMIT=10

# Rate limit for generation endpoints
GENERATION_RATE_LIMIT=5

# ==========================================================================
# COST CONTROL
# ==========================================================================

# Maximum cost per generation job (USD)
MAX_GENERATION_COST_USD=0.50

# Daily generation cap for free tier
FREE_TIER_DAILY_CAP=3

# Daily generation cap for star tier
STAR_TIER_DAILY_CAP=10

# Daily generation cap for superstar tier
SUPERSTAR_TIER_DAILY_CAP=25

# Daily generation cap for megastar tier
MEGASTAR_TIER_DAILY_CAP=100
